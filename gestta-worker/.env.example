# Luce E-BEF Sync no Windows (nao compartilhar .env, cookies ou tokens).
LUCE_SYNC_URL=https://lucesistemas.vercel.app/api/ebef/gestta-sync
LUCE_SYNC_TOKEN=COLE_UM_SEGREDO_ALEATORIO_FORTE_AQUI
GESTTA_START_MONTH=2026-01

# Somente preencher depois de inspecionar o HTML autenticado do Gestta.
# Coloque a URL COMPLETA ENTRE ASPAS para preservar o # da rota SPA.
# Exemplo: GESTTA_REPORT_URL="https://app.gestta.com.br/#/sidebar/task/overview/dashboard/ID"
GESTTA_REPORT_URL=
# Dashboard v2: o menu lateral Tarefas substitui os atalhos numericos.
# Opcional: CSS do item do menu esquerdo, confirmado no Playwright Inspector.
# Se vazio, usa getByText('Tarefas', { exact: true }) e exige item unico.
GESTTA_SIDEBAR_TASKS_SELECTOR=
GESTTA_EXPORT_SELECTOR=
# Confirmado com Playwright Inspector em 15/10/2026: identificador do campo geral
GESTTA_DATE_RANGE_SELECTOR="#date-range"
# Outro, inicio e fim identificados no Inspector em 15/10/2026; Aplicar usa getByRole pelo nome.
GESTTA_DATE_CUSTOM_SELECTOR=
GESTTA_DATE_START_SELECTOR=input[name="daterangepicker_start"]
GESTTA_DATE_END_SELECTOR=input[name="daterangepicker_end"]
# Opcional: somente necessário se houver mais de um botão Aplicar na interface.
GESTTA_DATE_APPLY_SELECTOR=
GESTTA_CLIENTS_ALL_SELECTOR=
GESTTA_USERS_ALL_SELECTOR=
GESTTA_DATE_MODE_SELECTOR=
# Tarefas E-BEF: abrir "Todas as tarefas", buscar "bef", rolar e marcar 3.
# Confirmado no Inspector em 16/10/2026:
#   Busca: getByRole('textbox', { name: 'Buscar por tarefa' })
#   Item: getByRole('menuitem', { name: 'DECLARAÇÃO DE EBEF | TÉCNICO' })
#         .getByRole('checkbox')
# Padrão: busca por nome acessível, 3 menuitems com EBEF e checkbox por item.
# Seletores CSS abaixo são OPCIONAIS, só se o Gestta mudar o HTML:
GESTTA_TASK_SEARCH_SELECTOR=
GESTTA_TASK_RESULT_ROW_SELECTOR=
GESTTA_TASK_ROW_CHECKBOX_SELECTOR=
# O Gestta preserva as tarefas selecionadas entre consultas.
# Confirmado no Inspector em 16/10/2026, no X do filtro superior:
# locator('#gestta-multiselect-dropdown-5-p').getByRole('button')
# O worker usa esse localizador por padrao; nao precisa editar o .env.
# Se o ID mudar, pode indicar um CSS alternativo EXCLUSIVO do filtro de tarefas.
# Nunca usar "button" generico ou posicoes como nth(4).
# So limpa se o container default ainda mostrar EBEF; depois verifica que
# "Todas as tarefas" reapareceu. Qualquer divergencia interrompe.
GESTTA_TASK_FILTER_CLEAR_SELECTOR=
# O worker aguarda 5s antes de verificar o filtro de tarefas.

# Filtros avancados - INSPECIONAR HTML, nao usar seletores supostos.
GESTTA_ADVANCED_OPEN_SELECTOR=
# Botao Filtrar confirmado no Inspector, por nome acessivel exato.
# CSS opcional, somente se o Gestta alterar o nome ou houver ambiguidade.
GESTTA_ADVANCED_APPLY_SELECTOR=
# Selecionar todos os departamentos, inclusive os desmarcados na captura.
# Todos os 21 departamentos são validados pelo nome e pelo checkbox.
# O seletor de linha deve excluir o controle "Selecionar todos".
# Campo Todos departamentos e opcao Selecionar todos confirmados no Inspector:
# getByText('Todos departamentos')
# getByRole('menuitem', {name:'Selecionar todos'}).locator('a')
# CSS alternativo opcional apenas se Gestta mudar a interface.
GESTTA_ADVANCED_DEPARTMENT_SELECTOR=
GESTTA_ADVANCED_DEPARTMENT_SELECT_ALL_SELECTOR=
GESTTA_ADVANCED_DEPARTMENT_ROW_SELECTOR=
# Selector relativo a cada linha para o checkbox correspondente:
GESTTA_ADVANCED_DEPARTMENT_ROW_CHECKBOX_SELECTOR=
# Os 4 status usam agora getByRole('checkbox') confirmado pelo Inspector:
# Aberta, Concluída, Impedimento, Desconsiderada. Não exigem CSS em .env.
# Os 3 tipos de tarefa tambem usam getByRole('checkbox') homologado:
# Fluxo de tarefas, Solicitação de serviço e Recorrente.
# Glifos auxiliares sao ignorados pelo localizador semantico.
# Nao e necessario definir seletores CSS para os tipos no .env.

GESTTA_DOWNLOAD_TIMEOUT_MS=120000
